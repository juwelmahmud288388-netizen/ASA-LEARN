# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# AUTH_SESSION_SECRET: Optional HMAC secret for server session tokens (defaults to secure ephemeral key in dev).
AUTH_SESSION_SECRET=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional JSON string of Firebase Admin service account for custom token minting in self-hosted environments.
FIREBASE_SERVICE_ACCOUNT_JSON=""
